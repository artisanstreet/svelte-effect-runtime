{
  "workspace": [
    "./modules/svelte-effect-runtime",
    "./modules/svelte-effect-runtime-grammars",
    "./modules/svelte-effect-runtime-language-server",
    "./modules/svelte-effect-runtime-vsix",
    "./modules/docs",
    "./.tests/svelte-effect-runtime"
  ],
  "imports": {
    "@effect/platform-node/": "npm:/@effect/platform-node@beta/",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "effect": "npm:effect@beta",
    "effect/": "npm:/effect@beta/",
    "rolldown": "npm:rolldown@^1.0.0-rc.13"
  },
  "lint": {
    "exclude": [
      "**/.dist/**",
      "**/runtime/**",
      "**/.tmp/**",
      "**/test/fixtures/**/build/**",
      "**/node_modules/**",
      "**/.svelte-kit/**",
      "**/.vercel/**",
      "**/*.vsix"
    ]
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno task build:grammars && deno task build:runtime && deno task build:lsp && deno task build:extension",
    "build:docs": "deno task --cwd modules/docs build",
    "build:grammars": "deno task --cwd modules/svelte-effect-runtime-grammars build",
    "build:runtime": "deno task --cwd modules/svelte-effect-runtime build",
    "build:lsp": "deno task --cwd modules/svelte-effect-runtime-language-server build",
    "build:extension": "deno task --cwd modules/svelte-effect-runtime-vsix build",
    "check": "deno task check:grammars && deno task check:runtime",
    "check:grammars": "deno task --cwd modules/svelte-effect-runtime-grammars check",
    "check:runtime": "deno task --cwd modules/svelte-effect-runtime check",
    "clean": "deno run -A build/clean.ts",
    "docs:dev": "deno task --cwd modules/docs dev",
    "lint": "deno lint",
    "package:extension": "deno task --cwd modules/svelte-effect-runtime-vsix package",
    "smoke:docs": "deno run -A build/smoke-docs.ts",
    "smoke:runtime": "deno run -A build/smoke-runtime.ts",
    "test": "deno task test:runtime",
    "test:lsp": "deno task build:lsp",
    "test:runtime": "deno task --cwd .tests/svelte-effect-runtime test"
  }
}
