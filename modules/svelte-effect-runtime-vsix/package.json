{
  "name": "svelte-effect-runtime-vscode",
  "displayName": "Svelte Effect Runtime",
  "description": "Higher level VSIX extension that has the SER LSP bundled.",
  "version": "1.6.2",
  "publisher": "barekey",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:svelte",
    "workspaceContains:**/*.svelte",
    "onCommand:svelte-effect-runtime.startLanguageServer",
    "onCommand:svelte-effect-runtime.stopLanguageServer",
    "onCommand:svelte-effect-runtime.restartLanguageServer",
    "onCommand:svelte-effect-runtime.showOutput"
  ],
  "files": [
    ".dist",
    "node_modules",
    "runtime",
    "README.md"
  ],
  "main": "./.dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "svelte",
        "aliases": [
          "Svelte",
          "svelte"
        ],
        "extensions": [
          ".svelte"
        ]
      }
    ],
    "commands": [
      {
        "command": "svelte-effect-runtime.startLanguageServer",
        "title": "Svelte Effect Runtime: Start Language Server"
      },
      {
        "command": "svelte-effect-runtime.stopLanguageServer",
        "title": "Svelte Effect Runtime: Stop Language Server"
      },
      {
        "command": "svelte-effect-runtime.restartLanguageServer",
        "title": "Svelte Effect Runtime: Restart Language Server"
      },
      {
        "command": "svelte-effect-runtime.showOutput",
        "title": "Svelte Effect Runtime: Show Output"
      }
    ],
    "configuration": {
      "title": "Svelte Effect Runtime",
      "properties": {
        "svelte-effect-runtime.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the bundled Svelte Effect Runtime language server automatically for Svelte files."
        },
        "svelte-effect-runtime.languageServer.client": {
          "type": "string",
          "enum": [
            "auto",
            "direct",
            "svelteExtension"
          ],
          "default": "auto",
          "description": "Language-client strategy. Auto uses the official Svelte extension client when installed to avoid duplicate Svelte language servers, otherwise it starts the bundled VS Code client directly."
        },
        "svelte-effect-runtime.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom svelte-effect-runtime-language-server script. Leave empty to use the bundled server."
        }
      }
    }
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "magic-string": "^0.30.21",
    "svelte": "^5.55.1",
    "svelte-language-server": "^0.17.30",
    "typescript": "^5.9.2",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1"
  }
}
