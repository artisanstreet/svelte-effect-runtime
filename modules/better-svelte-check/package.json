{
	"name": "better-svelte-check",
	"version": "5.0.1",
	"private": true,
	"description": "One-shot Svelte checking through the project's Vite source transforms.",
	"license": "BSD-3-Clause",
	"bin": {
		"better-svelte-check": "./src/cli.ts"
	},
	"type": "module",
	"scripts": {
		"build": "vp node ../../build/checker.ts",
		"check": "vp exec tsc -p tsconfig.json --noEmit",
		"start": "vp node -- src/cli.ts"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.5",
		"@jridgewell/trace-mapping": "^0.3.31",
		"effect": "4.0.5",
		"svelte-language-server": "0.18.4"
	},
	"peerDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.0",
		"typescript": "^6.0.0",
		"vite": "^8.2.0"
	}
}
