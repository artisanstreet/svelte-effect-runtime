{
  "name": "@barekey/svelte-effect-runtime",
  "version": "3.4.0",
  "license": "BSD-3-Clause",
  "exports": {
    ".": "./src/mod.ts",
    "./server": "./src/server.ts",
    "./vite": "./src/vite.ts",
    "./runtime/transform": "./src/runtime/transform.ts",
    "./internal/generators": "./src/internal/generators.ts",
    "./internal/remote-client": "./src/internal/remote-client.ts",
    "./internal/remote-server": "./src/internal/remote-server.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "es2022"]
  },
  "tasks": {
    "build": "deno task clean && deno run -A ../../build/runtime.ts && deno run -A npm:typescript@^6.0.0/tsc -p tsconfig.build.json --emitDeclarationOnly && deno run -A ../../build/rewrite-runtime-dts.ts",
    "check": "deno check --node-modules-dir=auto src/mod.ts src/runtime/transform.ts src/internal/generators.ts src/internal/remote-client.ts src/internal/remote-server.ts src/detect.ts src/dispatcher.ts src/generators.ts src/vite.ts src/remote/shared.ts src/remote/server.ts src/remote/client.ts src/markup/transform.ts src/markup/value.ts src/markup/promise.ts src/markup/run.ts",
    "clean": "deno run -A ../../build/clean.ts svelte-effect-runtime",
    "test": "deno task --cwd ../../.tests/svelte-effect-runtime test",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "$": "./src/mod.ts",
    "$/": "./src/",
    "$app/server": "./src/internal/sveltekit-server.ts",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/path": "jsr:@std/path@^1.1.2",
    "svelte-effect-runtime": "./src/mod.ts",
    "effect": "npm:effect@beta",
    "effect/": "npm:/effect@beta/",
    "@babel/parser": "npm:@babel/parser@^7.29.2",
    "devalue": "npm:devalue@^5.5.0",
    "svelte": "npm:svelte@^5.56.0",
    "svelte/": "npm:/svelte@^5.56.0/",
    "magic-string": "npm:magic-string@^0.30.21",
    "typescript": "npm:typescript@^6.0.0",
    "vite": "npm:vite@^8.0.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.0.0",
    "@sveltejs/kit": "npm:@sveltejs/kit@3.0.0-next.1",
    "@sveltejs/kit/": "npm:/@sveltejs/kit@3.0.0-next.1/",
    "@sveltejs/kit/internal/server": "npm:/@sveltejs/kit@3.0.0-next.1/internal/server"
  },
  "publish": {
    "exclude": []
  }
}
