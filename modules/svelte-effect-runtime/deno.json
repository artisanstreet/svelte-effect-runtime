{
  "name": "@barekey/svelte-effect-runtime",
  "version": "1.6.2",
  "license": "BSD-3-Clause",
  "exports": {
    ".": "./src/mod.ts",
    "./preprocess": "./src/preprocess.ts",
    "./vite": "./src/vite.ts",
    "./generators": "./src/generators.ts",
    "./_server": "./src/server.ts",
    "./remote/shared": "./src/remote/shared.ts",
    "./remote/client": "./src/remote/client.ts",
    "./remote/server": "./src/remote/server.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "es2022"]
  },
  "tasks": {
    "build": "deno task clean && deno run -A ../../build/runtime.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && deno run -A ../../build/rewrite-runtime-dts.ts",
    "check": "deno check --node-modules-dir=auto src/mod.ts src/detect.ts src/dispatcher.ts src/generators.ts src/preprocess.ts src/vite.ts src/remote/shared.ts src/remote/server.ts src/remote/client.ts src/markup/transform.ts src/markup/value.ts src/markup/promise.ts src/markup/run.ts",
    "clean": "rm -rf ../../.dist/svelte-effect-runtime",
    "test": "cd ../../.tests/svelte-effect-runtime && deno test --no-check -A v2",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "$": "./src/mod.ts",
    "$/": "./src/",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/path": "jsr:@std/path@^1.1.2",
    "svelte-effect-runtime": "./src/mod.ts",
    "effect": "npm:effect@beta",
    "effect/": "npm:/effect@beta/",
    "@babel/parser": "npm:@babel/parser@^7.29.2",
    "devalue": "npm:devalue@^5.5.0",
    "svelte": "npm:svelte@^5.55.1",
    "svelte/": "npm:/svelte@^5.55.1/",
    "magic-string": "npm:magic-string@^0.30.21",
    "typescript": "npm:typescript@^5.9.3",
    "vite": "npm:vite@^7.3.1",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.2.4",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.56.1",
    "@sveltejs/kit/": "npm:/@sveltejs/kit@^2.56.1/",
    "@sveltejs/kit/internal/server": "npm:/@sveltejs/kit@^2.56.1/internal/server"
  },
  "publish": {
    "exclude": []
  }
}
