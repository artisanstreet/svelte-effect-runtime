{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "../../.dist/svelte-effect-runtime",
    "declaration": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "$": ["./src/mod.ts"],
      "$/*": ["./src/*"]
    }
  },
  "include": [
    "./src/mod.ts",
    "./src/detect.ts",
    "./src/dispatcher.ts",
    "./src/generators.ts",
    "./src/lowering.ts",
    "./src/preprocess.ts"
  ]
}
