{
  "name": "svelte-effect-runtime",
  "version": "1.6.2",
  "description": "Core module that houses the Vite plugin to enable effectful execution.",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/usebarekey/svelte-effect-runtime.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./.dist/mod.d.ts",
      "default": "./.dist/mod.js"
    },
    "./preprocess": {
      "types": "./.dist/preprocess.d.ts",
      "default": "./.dist/preprocess.js"
    },
    "./generators": {
      "types": "./.dist/generators.d.ts",
      "default": "./.dist/generators.js"
    }
  },
  "scripts": {
    "build": "deno task build",
    "check": "deno task check",
    "clean": "deno task clean",
    "test": "deno task test"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0 || ^7.0.0",
    "effect": "^4.0.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "devalue": "^5.5.0",
    "magic-string": "^0.30.21",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "rolldown": "^1.0.0-rc.13"
  }
}
