{
	"name": "svelte-effect-runtime",
	"version": "5.0.0",
	"description": "Core module that houses the Vite plugin to enable effectful execution.",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/artisanstreet/svelte-effect-runtime.git"
	},
	"files": [
		".dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./.dist/mod.d.ts",
			"default": "./.dist/mod.js"
		},
		"./server": {
			"types": "./.dist/server.d.ts",
			"default": "./.dist/server.js"
		},
		"./compiler": {
			"types": "./.dist/compiler.d.ts",
			"default": "./.dist/compiler.js"
		},
		"./environment": {
			"types": "./.dist/environment.d.ts",
			"default": "./.dist/environment.js"
		},
		"./runtime/transform": {
			"types": "./.dist/runtime/transform.d.ts",
			"default": "./.dist/runtime/transform.js"
		},
		"./internal/generators": {
			"types": "./.dist/internal/generators.d.ts",
			"default": "./.dist/internal/generators.js"
		},
		"./internal/remote-client": {
			"types": "./.dist/internal/remote-client.d.ts",
			"default": "./.dist/internal/remote-client.js"
		},
		"./internal/remote-server": {
			"types": "./.dist/internal/remote-server.d.ts",
			"default": "./.dist/internal/remote-server.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "corepack pnpm run clean && vp node ../../build/runtime.ts && vp exec tsc -p tsconfig.build.json --emitDeclarationOnly && vp node ../../build/dts.ts svelte-effect-runtime",
		"check": "vp exec tsc -p tsconfig.build.json --noEmit",
		"clean": "vp node ../../build/clean.ts svelte-effect-runtime",
		"test": "corepack pnpm --dir ../.. run test"
	},
	"dependencies": {
		"devalue": "^5.5.0",
		"magic-string": "^0.30.21",
		"typescript": "^6.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "3.1.0",
		"@types/node": "^24.6.1",
		"effect": "4.0.5",
		"rolldown": "^1.0.0-rc.13",
		"svelte": "^5.57.2"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.69.0 || ^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0 || ^7.0.0",
		"effect": "^4.0.0",
		"svelte": "^5.44.0",
		"vite": "^7.0.0 || ^8.0.0"
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	}
}
