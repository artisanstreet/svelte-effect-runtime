{
  "name": "@barekey/svelte-effect-runtime-grammars",
  "version": "3.4.0",
  "license": "BSD-3-Clause",
  "exports": {
    ".": "./src/mod.ts",
    "./textmate": "./src/textmate.ts",
    "./tree-sitter": "./src/tree-sitter.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "es2022"
    ]
  },
  "tasks": {
    "build": "deno task clean && deno run -A ../../build/grammars.ts && deno run -A npm:typescript@^6.0.0/tsc -p tsconfig.build.json --emitDeclarationOnly && deno run -A ../../build/rewrite-grammars-dts.ts",
    "check": "deno check --node-modules-dir=auto src/mod.ts src/textmate.ts src/tree-sitter.ts",
    "clean": "rm -rf ../../.dist/svelte-effect-runtime-grammars",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "publish:npm": "deno run -A ../../build/publish-grammars-npm.ts",
    "test": "deno test --no-check -A"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "rolldown": "npm:rolldown@^1.0.0-rc.13",
    "typescript": "npm:typescript@^6.0.0"
  },
  "publish": {
    "exclude": []
  }
}
